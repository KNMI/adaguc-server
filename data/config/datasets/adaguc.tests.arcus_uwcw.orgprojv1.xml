<?xml version="1.0"?>
<Configuration>

  <Include location="{ADAGUC_PATH}/data/config/datasets/adaguc.tests.arcus_uwcw.xml"/>

  <!--
    Version 8.0.0 started enforcing the WMS 1.3.0 spec's authority-defined axis order for these
    projections (invertxyforwms130="true" in data/config/includes/Projection.include.xml), which
    swaps the BBOX axis order in GetCapabilities/GetMap for them (e.g. lat,lon instead of lon,lat
    for EPSG:4326). These overrides set invertxyforwms130 back to "false" so this dataset keeps
    the pre-8.0.0 (non-inverted) axis order, for configs that still depend on it.
  -->
  <Projection id="EPSG:4258" invertxyforwms130="false" proj4="+proj=longlat +ellps=GRS80 +no_defs"/>
  <Projection id="EPSG:4326" invertxyforwms130="false" proj4="+proj=longlat +ellps=WGS84 +datum=WGS84 +no_defs"/>
  <Projection id="EPSG:32661" invertxyforwms130="false" proj4="+proj=stere +lat_0=90 +lat_ts=90 +lon_0=0 +k=0.994 +x_0=2000000 +y_0=2000000 +ellps=WGS84 +datum=WGS84 +units=m +no_defs"/>
  <Projection id="EPSG:3035" invertxyforwms130="false" proj4="+proj=laea +lat_0=52 +lon_0=10 +x_0=4321000 +y_0=3210000 +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +units=m +no_defs +type=crs"/>

</Configuration>
