<?xml version="1.0"?>
<Configuration>


  <Layer type="database">
    <Group collection="ml"/>
    <Name>air_temperature_ml</Name>
    <Title>Air temperature at model level</Title>
    <Variable>air-temperature-ml</Variable>
    <FilePath filter="^uwcw\-ha\-det\-dini\-.*\.nc$">{ADAGUC_PATH}/data/datasets/arcustest_uwcw_ml/</FilePath>
    <Styles>auto</Styles>
    <Dimension name="forecast_reference_time" units="ISO8601" type="reference_time">reference_time</Dimension>
    <Dimension name="time" units="ISO8601" interval="PT1H" default="forecast_reference_time+PT1H" type="time">time</Dimension>
    <Dimension name="ml" units=" " default="min" type="vertical" hidden="false">model_level</Dimension>
  </Layer>


</Configuration>