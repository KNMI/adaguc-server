<?xml version="1.0" encoding="UTF-8" ?>
<Configuration>
  <!-- A small Lambert conformal conic grid (in metres) with five heights and two variables, for EDR cube requests with crs=native -->
  <Layer type="database">
    <Group collection="lambert"/>
    <Title>Wind speed on a Lambert conformal conic grid</Title>
    <Name>wspeed</Name>
    <FilePath>{ADAGUC_PATH}/data/datasets/test_lambert_two_parameters.nc</FilePath>
    <Variable>wspeed</Variable>
    <Styles>auto</Styles>
    <Dimension name="time" units="ISO8601">time</Dimension>
    <Dimension name="height" units="m" default="10" type="vertical">elevation</Dimension>
  </Layer>
  <Layer type="database">
    <Group collection="lambert"/>
    <Title>Wind speed in knots on a Lambert conformal conic grid</Title>
    <Name>wspeed_kts</Name>
    <FilePath>{ADAGUC_PATH}/data/datasets/test_lambert_two_parameters.nc</FilePath>
    <Variable>wspeed_kts</Variable>
    <Styles>auto</Styles>
    <Dimension name="time" units="ISO8601">time</Dimension>
    <Dimension name="height" units="m" default="10" type="vertical">elevation</Dimension>
  </Layer>
</Configuration>
